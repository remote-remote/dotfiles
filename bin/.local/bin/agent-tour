#!/usr/bin/env python3
"""Author a guided code tour for the agent-tours nvim plugin.

A tour is an ordered walk through a flow: file, line range, title, note. It is
compiled to <root>/.agent/tours/<id>.json, where nvim's watcher picks it up.
The reader opens it with :AgentTour and steps with ]t / [t.

  agent-tour create [--from FILE] [--root DIR] [--author NAME]

      Compile a draft (stdin, or --from) into a tour. The draft is JSON:

        {
          "id": "login-flow",                    optional; slugged from title
          "title": "How a login request becomes a session",
          "steps": [
            {
              "path": "src/auth/login.ts",       from the repo root or the cwd
              "range": [39, 52],                 1-indexed, inclusive
              "title": "Token minted here",      required; the panel is narrow
              "note": "What the code does not say.",
              "symbol": "handleLogin"            optional; treesitter fallback
            }
          ]
        }

      anchor.text is read out of the file rather than supplied: the first line
      of the range is the key nvim re-anchors against once the file is edited,
      so it has to match byte for byte. Start a range on a distinctive line.

      Re-running create on an existing id rewrites it, keeping created_at and
      the reader's cursor (clamped to the new step count).

  agent-tour list                tours for this root, with step counts
  agent-tour show ID             the compiled tour, as the panel will read it
  agent-tour cursor ID [N]       the step the reader is on; with N, drive them
  agent-tour rm ID               delete a tour

Nothing is written if any step fails validation. Warnings do not block a
write, but each one is a tour that degrades badly once the file moves.
"""

import json
import os
import re
import sys
import time
import unicodedata

PANEL_WIDTH = 38  # nvim/.config/nvim/lua/agent-tours/format.lua
SUBDIR = ".agent/tours"
MIN_STEPS, MAX_STEPS = 5, 12
MAX_SPAN = 40


def die(msg):
    sys.stderr.write("error: %s\n" % msg)
    sys.exit(1)


def display_width(s):
    w = 0
    for ch in s:
        if unicodedata.combining(ch):
            continue
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def repo_root(start):
    # vim.fs.root(start, ".git"), reimplemented: a worktree's .git is a file.
    cur = os.path.realpath(start)
    while True:
        if os.path.exists(os.path.join(cur, ".git")):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            return os.path.realpath(start)
        cur = parent


def tours_dir(root):
    return os.path.join(root, SUBDIR)


def slug(text):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:48].rstrip("-") or "tour"


def read_lines(path):
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        text = fh.read()
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    return lines


def resolve_path(rel, root):
    """A step path, read as root-relative or cwd-relative, whichever exists.

    Agents run this from wherever they happen to be standing, so both readings
    are plausible; returning the ambiguity is better than picking one and
    pointing a step at the wrong file.
    """
    if os.path.isabs(rel):
        found = os.path.realpath(rel)
        return (found if os.path.isfile(found) else None), None
    seen = []
    for base in (root, os.getcwd()):
        candidate = os.path.realpath(os.path.join(base, rel))
        if os.path.isfile(candidate) and candidate not in seen:
            seen.append(candidate)
    if len(seen) > 1:
        return None, (os.path.relpath(seen[0], root), os.path.relpath(seen[1], root))
    return (seen[0] if seen else None), None


def load_json(raw, what):
    try:
        return json.loads(raw)
    except ValueError as exc:
        die("%s is not valid json: %s" % (what, exc))


def tour_path(root, tour_id):
    return os.path.join(tours_dir(root), tour_id + ".json")


def read_tour(root, tour_id):
    path = tour_path(root, tour_id)
    if not os.path.exists(path):
        die("no tour %s in %s" % (tour_id, tours_dir(root)))
    with open(path, "r", encoding="utf-8") as fh:
        return load_json(fh.read(), path), path


def write_tour(path, tour):
    # Temp file plus rename, so the fs_event watcher never reads a half tour.
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(tour, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, path)


def compile_tour(draft, root, author, existing):
    errors, warnings = [], []

    if not isinstance(draft, dict):
        die("draft must be a json object with `title` and `steps`")

    title = str(draft.get("title") or "").strip()
    if not title:
        errors.append("title: required, and it is the panel header")
    elif display_width(title) > 72:
        warnings.append("title: %d columns wraps to three panel rows; aim under 72"
                        % display_width(title))

    tour_id = str(draft.get("id") or "").strip() or slug(title)
    if not re.match(r"^[A-Za-z0-9._-]+$", tour_id):
        errors.append("id: %r is not a filename; use letters, digits, . _ -" % tour_id)

    raw_steps = draft.get("steps")
    if not isinstance(raw_steps, list) or not raw_steps:
        errors.append("steps: required, a non-empty list")
        raw_steps = []

    # The panel gives a title `width - (number width + 3)` columns before it
    # truncates with an ellipsis.
    title_budget = PANEL_WIDTH - (len(str(max(len(raw_steps), 1))) + 3)

    steps = []
    for i, raw in enumerate(raw_steps, 1):
        where = "step %d" % i
        if not isinstance(raw, dict):
            errors.append("%s: not an object" % where)
            continue

        step_title = str(raw.get("title") or "").strip()
        note = str(raw.get("note") or "").strip()
        rel = str(raw.get("path") or "").strip()

        if not step_title:
            errors.append("%s: title is required; without one the panel guesses "
                          "from the note's first sentence" % where)
        elif display_width(step_title) > title_budget:
            warnings.append("%s: title is %d columns, panel truncates at %d: %r"
                            % (where, display_width(step_title), title_budget, step_title))
        if not note:
            errors.append("%s: note is required" % where)
        if not rel:
            errors.append("%s: path is required" % where)
            continue

        abs_path, clash = resolve_path(rel, root)
        if clash:
            errors.append("%s: %s exists both as %s and as %s; give the path from "
                          "the repo root" % (where, rel, clash[0], clash[1]))
            continue
        if not abs_path:
            errors.append("%s: no file at %s, from the repo root or the working "
                          "directory" % (where, rel))
            continue
        if os.path.commonpath([abs_path, root]) != root:
            errors.append("%s: %s is outside the tour root %s" % (where, rel, root))
            continue
        rel = os.path.relpath(abs_path, root)

        rng = raw.get("range")
        if isinstance(rng, int):
            rng = [rng, rng]
        if (not isinstance(rng, list) or not rng
                or not all(isinstance(n, int) for n in rng[:2])):
            errors.append("%s: range must be [start, end] or a single line number" % where)
            continue
        start = rng[0]
        end = rng[1] if len(rng) > 1 else start

        lines = read_lines(abs_path)
        if start < 1 or start > len(lines):
            errors.append("%s: line %d is outside %s (%d lines)"
                          % (where, start, rel, len(lines)))
            continue
        if end < start:
            errors.append("%s: range ends (%d) before it starts (%d)" % (where, end, start))
            continue
        if end > len(lines):
            errors.append("%s: range ends at %d but %s has %d lines"
                          % (where, end, rel, len(lines)))
            continue

        anchor_text = lines[start - 1]
        if not anchor_text.strip():
            errors.append("%s: line %d is blank, and the first line of the range is "
                          "the anchor; start on a line with code" % (where, start))
            continue

        symbol = str(raw.get("symbol") or "").strip()
        if lines.count(anchor_text) > 1 and not symbol:
            warnings.append("%s: %s:%d (%r) is not unique in the file, so an edit "
                            "above it breaks the step; start the range on a "
                            "distinctive line, or add a `symbol` to scope it"
                            % (where, rel, start, anchor_text.strip()))
        if end - start + 1 > MAX_SPAN:
            warnings.append("%s: spans %d lines; a range that big is usually two steps "
                            "or a tighter window" % (where, end - start + 1))

        anchor = {"text": anchor_text}
        if symbol:
            anchor["symbol"] = symbol
        steps.append({
            "path": rel,
            "title": step_title,
            "range": [start, end],
            "anchor": anchor,
            "note": note,
        })

    if raw_steps and not errors:
        if len(steps) < MIN_STEPS:
            warnings.append("%d steps: a walk this short is usually the obvious "
                            "shape of the flow rather than a tour" % len(steps))
        elif len(steps) > MAX_STEPS:
            warnings.append("%d steps: cut the ones that are there for flow rather "
                            "than for something the reader could not see" % len(steps))

    if errors:
        for e in errors:
            sys.stderr.write("error: %s\n" % e)
        sys.exit(1)

    created = existing.get("created_at") if existing else None
    cursor = existing.get("cursor", 0) if existing else 0
    if not isinstance(cursor, int) or cursor < 0 or cursor >= len(steps):
        cursor = 0

    return {
        "version": 1,
        "id": tour_id,
        "title": title,
        "root": root,
        "author": {"kind": "agent", "name": author},
        "created_at": created or time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "cursor": cursor,
        "steps": steps,
    }, warnings


def print_steps(tour):
    numw = len(str(len(tour["steps"])))
    budget = PANEL_WIDTH - (numw + 3)
    for i, step in enumerate(tour["steps"], 1):
        title = step["title"]
        if display_width(title) > budget:
            title = title[: budget - 1] + "…"
        sys.stdout.write("  %*d  %-*s  %s:%d\n"
                         % (numw, i, budget, title, step["path"], step["range"][0]))


def take_flags(args, names):
    values, rest, i = {}, [], 0
    while i < len(args):
        arg = args[i]
        if arg in names:
            if i + 1 >= len(args):
                die("%s needs a value" % arg)
            values[arg] = args[i + 1]
            i += 2
        elif arg.startswith("--"):
            die("unknown option: %s" % arg)
        else:
            rest.append(arg)
            i += 1
    return values, rest


def cmd_create(args):
    flags, rest = take_flags(args, ("--from", "--root", "--author"))
    if rest:
        die("create takes no positional arguments (the draft is stdin or --from)")

    root = repo_root(flags.get("--root") or os.getcwd())
    author = flags.get("--author") or os.environ.get("AGENT_TOUR_AUTHOR") or "agent"

    source = flags.get("--from")
    if source:
        if not os.path.isfile(source):
            die("no draft at %s" % source)
        with open(source, "r", encoding="utf-8") as fh:
            raw = fh.read()
    else:
        if sys.stdin.isatty():
            die("no draft on stdin (use --from FILE, or pipe json in)")
        raw = sys.stdin.read()
    draft = load_json(raw, source or "the draft")

    existing = None
    tour_id = str(draft.get("id") or "").strip() or slug(str(draft.get("title") or ""))
    path = tour_path(root, tour_id)
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as fh:
            existing = load_json(fh.read(), path)

    tour, warnings = compile_tour(draft, root, author, existing)
    write_tour(tour_path(root, tour["id"]), tour)

    for w in warnings:
        sys.stderr.write("warning: %s\n" % w)
    sys.stdout.write("%s %s (%d steps)\n"
                     % ("updated" if existing else "wrote",
                        tour_path(root, tour["id"]), len(tour["steps"])))
    print_steps(tour)
    sys.stdout.write("  open it with :AgentTour %s\n" % tour["id"])
    return 0


def cmd_list(args):
    flags, rest = take_flags(args, ("--root",))
    if rest:
        die("list takes no arguments")
    root = repo_root(flags.get("--root") or os.getcwd())
    directory = tours_dir(root)
    if not os.path.isdir(directory):
        sys.stdout.write("no tours in %s\n" % directory)
        return 0
    found = 0
    for name in sorted(os.listdir(directory)):
        if not name.endswith(".json"):
            continue
        path = os.path.join(directory, name)
        try:
            with open(path, "r", encoding="utf-8") as fh:
                tour = json.load(fh)
        except ValueError as exc:
            sys.stdout.write("%-24s unreadable: %s\n" % (name, exc))
            continue
        if os.path.realpath(tour.get("root", "")) != root:
            continue
        found += 1
        sys.stdout.write("%-24s %d steps, on %d/%d  %s\n"
                         % (tour.get("id", name), len(tour.get("steps", [])),
                            tour.get("cursor", 0) + 1, len(tour.get("steps", [])),
                            tour.get("title", "")))
    if not found:
        sys.stdout.write("no tours for %s in %s\n" % (root, directory))
    return 0


def cmd_show(args):
    flags, rest = take_flags(args, ("--root",))
    if len(rest) != 1:
        die("usage: agent-tour show ID")
    root = repo_root(flags.get("--root") or os.getcwd())
    tour, path = read_tour(root, rest[0])
    sys.stdout.write("%s  (%s, %d steps, reader on %d)\n"
                     % (tour.get("title", ""), path, len(tour.get("steps", [])),
                        tour.get("cursor", 0) + 1))
    print_steps(tour)
    for i, step in enumerate(tour.get("steps", []), 1):
        sys.stdout.write("\n%d. %s  %s:%d-%d\n%s\n"
                         % (i, step.get("title", ""), step.get("path", ""),
                            step.get("range", [0, 0])[0], step.get("range", [0, 0])[-1],
                            step.get("note", "")))
    return 0


def cmd_cursor(args):
    flags, rest = take_flags(args, ("--root",))
    if not rest or len(rest) > 2:
        die("usage: agent-tour cursor ID [N]")
    root = repo_root(flags.get("--root") or os.getcwd())
    tour, path = read_tour(root, rest[0])
    total = len(tour.get("steps", []))

    if len(rest) == 1:
        index = tour.get("cursor", 0)
        step = tour["steps"][index] if 0 <= index < total else {}
        sys.stdout.write("%d/%d  %s\n" % (index + 1, total, step.get("title", "")))
        return 0

    try:
        want = int(rest[1])
    except ValueError:
        die("step must be a number between 1 and %d" % total)
    if want < 1 or want > total:
        die("step %d is outside this tour (1-%d)" % (want, total))
    tour["cursor"] = want - 1
    write_tour(path, tour)
    sys.stdout.write("%d/%d  %s\n" % (want, total, tour["steps"][want - 1].get("title", "")))
    return 0


def cmd_rm(args):
    flags, rest = take_flags(args, ("--root",))
    if len(rest) != 1:
        die("usage: agent-tour rm ID")
    root = repo_root(flags.get("--root") or os.getcwd())
    _, path = read_tour(root, rest[0])
    os.remove(path)
    sys.stdout.write("removed %s\n" % path)
    return 0


COMMANDS = {
    "create": cmd_create,
    "list": cmd_list,
    "show": cmd_show,
    "cursor": cmd_cursor,
    "rm": cmd_rm,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__.strip() + "\n")
        return 0
    handler = COMMANDS.get(argv[0])
    if not handler:
        die("unknown command %r (try --help)" % argv[0])
    return handler(argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
