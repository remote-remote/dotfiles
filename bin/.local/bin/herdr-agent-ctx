#!/usr/bin/env python3
"""Report agent context usage and prompt-cache countdown to the herdr sidebar.

  statusline   read Claude Code's statusLine JSON on stdin, push $ctx/$cache/$cold for
               $HERDR_PANE_ID, print a status line
  tick         refresh every agent pane herdr knows about from its transcript,
               for claude sessions the statusLine hook does not cover and for pi,
               which has no statusLine equivalent at all
  clear        drop our tokens on $HERDR_PANE_ID
"""

import calendar
import json
import os
import socket
import sys
import time
import glob

SOURCE = "user:cc-ctx"
TTL_MS = 60_000
SOCKET_TIMEOUT = 0.5
# tick must not clobber a fresher statusLine value with a coarser transcript one
STATUSLINE_GRACE = 30.0

CACHE_GLYPH = "⧗"
COLD_GLYPH = "❄"
# Re-caching a small context costs about as much as the message that triggers it,
# so only warn once a cold send is genuinely expensive.
COLD_WARN_MIN_TOKENS = 20_000


def sidecar_dir():
    d = os.path.join(os.environ.get("TMPDIR", "/tmp"), "herdr-agent-ctx")
    os.makedirs(d, exist_ok=True)
    return d


def sidecar_path(pane_id):
    return os.path.join(sidecar_dir(), pane_id.replace(":", "_"))


def read_sidecar(pane_id):
    try:
        with open(sidecar_path(pane_id)) as f:
            return json.load(f)
    except Exception:
        return None


def write_sidecar(pane_id, tokens, by):
    try:
        with open(sidecar_path(pane_id), "w") as f:
            json.dump({"at": time.time(), "tokens": tokens, "by": by}, f)
    except Exception:
        pass


def call(sock_path, method, params):
    """One request/response against the herdr control socket."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(SOCKET_TIMEOUT)
    try:
        s.connect(sock_path)
        req = {"id": "cc-ctx", "method": method, "params": params}
        s.sendall((json.dumps(req) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf) if buf else None
    finally:
        s.close()


def report(sock_path, pane_id, tokens, agent):
    """tokens: {name: value or None}. None clears the key."""
    return call(
        sock_path,
        "pane.report_metadata",
        {
            "pane_id": pane_id,
            "source": SOURCE,
            "agent": agent,
            "seq": time.time_ns(),
            "ttl_ms": TTL_MS,
            "tokens": tokens,
        },
    )


def agent_status(sock_path, pane_id):
    try:
        r = call(sock_path, "pane.get", {"pane_id": pane_id})
        return r["result"]["pane"].get("agent_status")
    except Exception:
        return None


def compact(n):
    if n is None:
        return "?"
    if n >= 1_000_000:
        return "%.1fM" % (n / 1_000_000)
    if n >= 1_000:
        return "%dk" % round(n / 1_000)
    return str(n)


def fmt_countdown(seconds):
    if seconds is None or seconds <= 0:
        return None
    m = int(seconds // 60)
    if m < 1:
        return CACHE_GLYPH + "<1m"
    if m < 60:
        return CACHE_GLYPH + "%dm" % m
    return CACHE_GLYPH + "%dh%02dm" % (m // 60, m % 60)


def cold_token(tokens):
    """What a message sent right now would pay to rebuild the prompt cache."""
    if not tokens or tokens < COLD_WARN_MIN_TOKENS:
        return None
    return COLD_GLYPH + compact(tokens)


def iso_epoch(ts):
    """ISO-8601 Z timestamp to epoch seconds, ignoring sub-second precision."""
    if not ts:
        return None
    try:
        return calendar.timegm(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S"))
    except Exception:
        return None


def ctx_token(used, size, approx=False):
    """An unknown window degrades to a raw token count, never to a wrong percent."""
    if not used:
        return None
    prefix = "~" if approx else ""
    if not size:
        return prefix + compact(used)
    pct = used / size * 100.0
    shown = "%.1f%%" % pct if pct < 10 else "%d%%" % round(pct)
    return "%s%s %s" % (prefix, shown, compact(used))


def push(sock_path, pane_id, tokens, agent, by, force=False):
    """Skip the write when nothing changed and the TTL is not close to lapsing."""
    prev = read_sidecar(pane_id)
    if (
        not force
        and prev
        and prev.get("tokens") == tokens
        and (time.time() - prev.get("at", 0)) < (TTL_MS / 1000.0) / 2
    ):
        return
    report(sock_path, pane_id, tokens, agent)
    write_sidecar(pane_id, tokens, by)


# --------------------------------------------------------------------------
# statusline
# --------------------------------------------------------------------------

def cmd_statusline():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0

    cw = payload.get("context_window") or {}
    used = cw.get("total_input_tokens")
    size = cw.get("context_window_size")
    has_usage = cw.get("current_usage") is not None

    pc = payload.get("prompt_cache") or {}
    # warm is false both before anything was cached and after it lapsed; only the
    # second is worth warning about
    ever_cached = pc.get("caching_observed") or bool(pc.get("requests"))
    cache = cold = None
    if pc.get("warm"):
        if pc.get("expires_at"):
            cache = fmt_countdown(pc["expires_at"] - time.time())
    elif ever_cached:
        cold = cold_token(pc.get("recache_tokens_if_cold") or used)

    ctx = ctx_token(used, size) if has_usage else None

    sock_path = os.environ.get("HERDR_SOCKET_PATH")
    pane_id = os.environ.get("HERDR_PANE_ID")
    if os.environ.get("HERDR_ENV") == "1" and sock_path and pane_id:
        try:
            # neither number means anything while the agent is rebuilding the cache
            if agent_status(sock_path, pane_id) == "working":
                cache = cold = None
            push(
                sock_path,
                pane_id,
                {"ctx": ctx, "cache": cache, "cold": cold},
                "claude",
                "statusline",
            )
        except Exception:
            pass

    print(status_line(payload, ctx, cache, cold))
    return 0


def status_line(payload, ctx, cache, cold):
    parts = []
    model = (payload.get("model") or {}).get("display_name")
    if model:
        parts.append(model)
    effort = (payload.get("effort") or {}).get("level")
    if effort:
        parts.append(effort)
    if ctx:
        cw = payload.get("context_window") or {}
        parts.append("%s/%s" % (ctx, compact(cw.get("context_window_size"))))
    if cache:
        parts.append("cache %s" % cache.replace(CACHE_GLYPH, ""))
    if cold:
        parts.append("cache cold %s" % cold.replace(COLD_GLYPH, ""))
    return "  ".join(parts)


# --------------------------------------------------------------------------
# transcript scanners
#
# Each returns {"used", "size", "ttl", "anchor"} so cmd_tick stays agent-agnostic.
# "used" is None when the context is genuinely unknown (right after a compaction).
# "anchor" is epoch seconds at the winning turn's request start, because Anthropic
# refreshes a cache entry when it is read, not when the response completes.
# --------------------------------------------------------------------------

def transcript_for(agent_record):
    """herdr hands pi an absolute path and claude a bare session id."""
    sess = agent_record.get("agent_session") or {}
    value = sess.get("value")
    if not value:
        return None
    if sess.get("kind") == "path":
        return value if os.path.exists(value) else None
    hits = glob.glob(os.path.expanduser("~/.claude/projects/*/%s.jsonl" % value))
    return hits[0] if hits else None


def claude_window():
    """The transcript strips the [1m] suffix, so fall back to the configured model."""
    try:
        with open(os.path.expanduser("~/.claude/settings.json")) as f:
            model = json.load(f).get("model") or ""
        return 1_000_000 if "[1m]" in model else 200_000
    except Exception:
        return 200_000


def scan_claude(path):
    """Last main-thread assistant turn wins, which also handles /compact."""
    used = ttl = anchor = None
    prev_ts = None
    try:
        with open(path, "rb") as f:
            for raw in f:
                try:
                    rec = json.loads(raw)
                except Exception:
                    continue
                if rec.get("isSidechain"):
                    continue
                if rec.get("type") != "assistant":
                    prev_ts = rec.get("timestamp") or prev_ts
                    continue
                usage = (rec.get("message") or {}).get("usage") or {}
                if not usage:
                    continue
                used = (
                    usage.get("input_tokens", 0)
                    + usage.get("cache_creation_input_tokens", 0)
                    + usage.get("cache_read_input_tokens", 0)
                )
                cc = usage.get("cache_creation") or {}
                if cc.get("ephemeral_1h_input_tokens"):
                    ttl = 3600
                elif cc.get("ephemeral_5m_input_tokens"):
                    ttl = 300
                anchor = iso_epoch(prev_ts) or iso_epoch(rec.get("timestamp"))
                prev_ts = rec.get("timestamp") or prev_ts
    except Exception:
        return None
    if used is None:
        return None
    return {
        "used": used,
        "size": claude_window(),
        "ttl": ttl,
        "anchor": anchor or os.path.getmtime(path),
    }


def pi_windows():
    """provider/modelId -> contextWindow, from pi's catalogue then user overrides."""
    windows = {}
    for p in ("~/.pi/agent/models-store.json", "~/.pi/agent/models.json"):
        try:
            with open(os.path.expanduser(p)) as f:
                data = json.load(f)
        except Exception:
            continue
        providers = data.get("providers", data)
        if not isinstance(providers, dict):
            continue
        for provider, v in providers.items():
            for m in (v or {}).get("models") or []:
                if m.get("contextWindow"):
                    windows["%s/%s" % (provider, m.get("id"))] = m["contextWindow"]
    return windows


def scan_pi(path):
    """Last usable assistant turn wins. pi records its own context total per turn."""
    used = ttl = anchor = None
    model = provider = None
    prev_ts = None
    compacted = False
    cache_seen = False
    try:
        with open(path, "rb") as f:
            for raw in f:
                try:
                    rec = json.loads(raw)
                except Exception:
                    continue
                kind = rec.get("type")
                if kind in ("compaction", "branch_summary"):
                    compacted = True
                    continue
                if kind == "model_change":
                    model = rec.get("modelId") or model
                    provider = rec.get("provider") or provider
                    continue
                if kind != "message":
                    continue
                m = rec.get("message") or {}
                if m.get("role") != "assistant":
                    prev_ts = rec.get("timestamp") or prev_ts
                    continue
                if m.get("stopReason") in ("aborted", "error"):
                    continue
                u = m.get("usage") or {}
                total = u.get("totalTokens") or (
                    u.get("input", 0)
                    + u.get("output", 0)
                    + u.get("cacheRead", 0)
                    + u.get("cacheWrite", 0)
                )
                if not total:
                    continue
                used = total
                model = m.get("model") or model
                provider = m.get("provider") or provider
                if u.get("cacheRead") or u.get("cacheWrite"):
                    cache_seen = True
                ttl = 3600 if u.get("cacheWrite1h") else 300
                anchor = iso_epoch(prev_ts)
                if anchor is None and m.get("timestamp"):
                    anchor = m["timestamp"] / 1000.0
                compacted = False
                prev_ts = rec.get("timestamp") or prev_ts
    except Exception:
        return None
    if used is None:
        return None
    return {
        # pi reports no context total until the first turn after a compaction
        "used": None if compacted else used,
        "size": pi_windows().get("%s/%s" % (provider, model)),
        # a provider that never cached is not on a 5m Anthropic clock
        "ttl": ttl if cache_seen else None,
        "anchor": anchor or os.path.getmtime(path),
    }


SCANNERS = {"claude": scan_claude, "pi": scan_pi}


# --------------------------------------------------------------------------
# tick
# --------------------------------------------------------------------------

def cmd_tick():
    sock_path = os.environ.get("HERDR_SOCKET_PATH")
    if not sock_path:
        return 0
    try:
        r = call(sock_path, "agent.list", {})
        agents = r["result"]["agents"]
    except Exception:
        return 0

    now = time.time()

    for a in agents:
        agent = a.get("agent")
        scan = SCANNERS.get(agent)
        pane_id = a.get("pane_id")
        if not scan or not pane_id:
            continue
        prev = read_sidecar(pane_id)
        if (
            prev
            and prev.get("by") == "statusline"
            and (now - prev.get("at", 0)) < STATUSLINE_GRACE
        ):
            continue  # statusLine has this pane covered with better data
        path = transcript_for(a)
        if not path:
            continue
        info = scan(path)
        if not info:
            continue

        ctx = ctx_token(info["used"], info["size"], approx=True)

        cache = cold = None
        if info["ttl"] and a.get("agent_status") in ("idle", "done"):
            remaining = info["anchor"] + info["ttl"] - now
            cache = fmt_countdown(remaining)
            if cache is None:
                cold = cold_token(info["used"])

        try:
            push(
                sock_path,
                pane_id,
                {"ctx": ctx, "cache": cache, "cold": cold},
                agent,
                "tick",
                force=True,
            )
        except Exception:
            pass

    return 0


def cmd_clear():
    sock_path = os.environ.get("HERDR_SOCKET_PATH")
    pane_id = os.environ.get("HERDR_PANE_ID")
    if not sock_path or not pane_id:
        return 1
    report(sock_path, pane_id, {"ctx": None, "cache": None, "cold": None}, None)
    try:
        os.remove(sidecar_path(pane_id))
    except Exception:
        pass
    return 0


COMMANDS = {"statusline": cmd_statusline, "tick": cmd_tick, "clear": cmd_clear}

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "statusline"
    fn = COMMANDS.get(cmd)
    if not fn:
        sys.stderr.write("usage: herdr-agent-ctx {%s}\n" % "|".join(COMMANDS))
        sys.exit(2)
    try:
        sys.exit(fn())
    except Exception:
        sys.exit(0)  # never break the status line or the tab bar
