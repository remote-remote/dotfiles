#!/usr/bin/env zsh

# Print the directories a sessionizer should offer, one per line.
#
# Reads SESSIONIZER_DIRS from sessionizer.conf beside this script as invoked
# (~/.local/bin when run from PATH, not the dotfiles checkout the symlink
# points at). Each entry is a path, optionally suffixed :MIN:MAX to search that
# root at those find depths; a bare path offers just that directory.
#
#   SESSIONIZER_DIRS=(~/code:1:2 ~/dotfiles)
#
# The conf is sourced, so an entry may be a glob -- zsh expands it before this
# script sees it, and each match becomes its own bare entry. Globs that match
# nothing vanish rather than erroring, so a conf may name a directory that
# doesn't exist yet.
#
#   SESSIONIZER_DIRS=(~/code:1:2 ~/code/*/*__worktrees/*)
#
# SESSIONIZER_EXCLUDE drops paths matching any of its zsh patterns. Reaching
# past a directory you don't want to offer takes both: the glob to pull the
# children up, the exclude to drop the container the depth search found.
#
#   SESSIONIZER_EXCLUDE=('*__worktrees')
#
# A bare entry falls back to MIN_DEPTH / MAX_DEPTH when the conf sets them, so
# confs predating per-entry depths keep their behavior. Default: immediate
# directories in $HOME.
#
# Roots that are missing or unreadable are skipped, so one stale conf entry
# doesn't cost the others. Exits 2 on a malformed conf, 1 when no root survives.
#
# usage: sessionizer-dirs

set -euo pipefail

SELF=${0:t}

SESSIONIZER_DIRS=("$HOME:1:1")
SESSIONIZER_EXCLUDE=()

# A conf glob names directories that may legitimately not exist yet, so an
# empty match has to produce no entry instead of aborting the source.
setopt null_glob

CONFIG_FILE=${0:a:h}/sessionizer.conf
[[ ! -f $CONFIG_FILE ]] || source "$CONFIG_FILE"

# Depths for entries that carry none. Unset globals mean a bare entry is the
# directory itself; a conf that sets them keeps aiming bare entries at its
# own depths.
BARE_MIN=${MIN_DEPTH-0}
BARE_MAX=${MAX_DEPTH-0}
[[ $BARE_MIN == <-> && $BARE_MAX == <-> && $BARE_MIN -le $BARE_MAX ]] \
  || { print -u2 "$SELF: MIN_DEPTH / MAX_DEPTH must be nonnegative integers with MIN_DEPTH <= MAX_DEPTH"; exit 2 }

# Trailing :MIN:MAX wins over the bare defaults. Matching the last two colon
# fields leaves earlier colons to the path.
SEARCH_ROOTS=()
SEARCH_MINS=()
SEARCH_MAXS=()
for spec in "${SESSIONIZER_DIRS[@]}"; do
  if [[ $spec == *:<->:<-> ]]; then
    root=${${spec%:*}%:*}
    min=${${spec%:*}##*:}
    max=${spec##*:}
    [[ $min -le $max ]] \
      || { print -u2 "$SELF: $spec: depths must be MIN:MAX with MIN <= MAX"; exit 2 }
  else
    root=$spec
    min=$BARE_MIN
    max=$BARE_MAX
  fi
  [[ -d $root && -r $root && -x $root ]] || continue
  SEARCH_ROOTS+=("$root")
  SEARCH_MINS+=("$min")
  SEARCH_MAXS+=("$max")
done
(( ${#SEARCH_ROOTS[@]} )) || {
  print -u2 "$SELF: no accessible search roots; SESSIONIZER_DIRS entries are missing or unreadable"
  exit 1
}

excluded() {
  local pattern
  for pattern in "${SESSIONIZER_EXCLUDE[@]}"; do
    [[ $1 == ${~pattern} ]] && return 0
  done
  return 1
}

# Keep partial results from inaccessible descendants: a permission error under
# one root must not empty the picker.
#
# Overlapping entries are normal once globs are in play -- a glob and a depth
# search can reach the same directory -- so first hit wins and later ones are
# dropped, preserving conf order.
typeset -A seen
for (( i = 1; i <= ${#SEARCH_ROOTS[@]}; i++ )); do
  find "${SEARCH_ROOTS[i]}" -mindepth "${SEARCH_MINS[i]}" -maxdepth "${SEARCH_MAXS[i]}" \
    -type d 2>/dev/null || true
done | while IFS= read -r found; do
  [[ -n $found ]] || continue
  (( ${+seen[$found]} )) && continue
  seen[$found]=1
  excluded "$found" || print -r -- "$found"
done
