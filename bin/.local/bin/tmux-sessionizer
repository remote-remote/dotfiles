#!/usr/bin/env zsh

# Pick a directory and switch to its tmux session, creating it if needed.
#
# With no argument, pick from what `sessionizer-dirs` offers -- the same
# sessionizer.conf that herdr-sessionizer reads, whose entries are paths with an
# optional :MIN:MAX search-depth suffix. See that script for the format.
#
#   SESSIONIZER_DIRS=(~/code:1:2 ~/dotfiles)
#
# usage: tmux-sessionizer [dir]

if [[ $# -eq 1 ]]; then
    selected=$1
else
  # Listed up front rather than piped straight into fzf: a malformed conf has to
  # surface as its own exit status, not get flattened into fzf's "no matches".
  candidates=$("${0:a:h}/sessionizer-dirs") || exit $?
  [[ -n $candidates ]] || exit 0
  selected=$(print -rl -- "${(@f)candidates}" | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)


if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

tmux switch-client -t $selected_name
