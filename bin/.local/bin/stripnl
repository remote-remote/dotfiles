#!/usr/bin/env python3
import sys, re

LIST_RE = re.compile(r'^\s*([-*+]|\d+[.)])\s')

def strip_wraps(text):
    lines = text.split('\n')
    out = []
    in_code = False

    def is_break(l):
        """Lines that never merge into the line above them."""
        s = l.strip()
        return (s == '' or s.startswith('#') or s.startswith('|')
                or s.startswith('>') or s.startswith('```')
                or LIST_RE.match(l) is not None)

    # frontmatter only if file starts with ---
    i = 0
    if lines and lines[0].strip() == '---':
        out.append(lines[0])
        i = 1
        while i < len(lines):
            out.append(lines[i])
            if lines[i].strip() == '---':
                i += 1
                break
            i += 1

    while i < len(lines):
        line = lines[i]
        if line.strip().startswith('```'):
            in_code = not in_code
            out.append(line)
            i += 1
            continue
        if in_code or (is_break(line) and not LIST_RE.match(line)):
            out.append(line)
            i += 1
            continue
        # prose line or list item: absorb its wrapped continuation lines
        buf = line
        i += 1
        while i < len(lines) and not is_break(lines[i]):
            buf = buf.rstrip() + ' ' + lines[i].lstrip()
            i += 1
        out.append(buf)

    return '\n'.join(out)

if __name__ == '__main__':
    for path in sys.argv[1:]:
        with open(path) as f:
            src = f.read()
        with open(path, 'w') as f:
            f.write(strip_wraps(src))
