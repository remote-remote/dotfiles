#!/usr/bin/env python3
import sys, re

def strip_wraps(text):
    lines = text.split('\n')
    out = []
    in_fm = False
    in_code = False

    def is_protected(l):
        s = l.strip()
        return (s == '' or s.startswith('#') or s.startswith('|')
                or re.match(r'^\s*([-*+]|\d+\.)\s', l) is not None
                or re.match(r'^\s*>', l) is not None)

    # frontmatter only if file starts with ---
    i = 0
    if lines and lines[0].strip() == '---':
        out.append(lines[0])
        i = 1
        while i < len(lines):
            out.append(lines[i])
            if lines[i].strip() == '---':
                i += 1
                break
            i += 1

    while i < len(lines):
        line = lines[i]
        if line.strip().startswith('```'):
            in_code = not in_code
            out.append(line)
            i += 1
            continue
        if in_code or is_protected(line):
            out.append(line)
            i += 1
            continue
        # prose line: join following prose lines until a protected/blank line
        buf = line
        i += 1
        while i < len(lines):
            nxt = lines[i]
            if (nxt.strip() == '' or is_protected(nxt)
                    or nxt.strip().startswith('```')):
                break
            buf = buf.rstrip() + ' ' + nxt.lstrip()
            i += 1
        out.append(buf)

    return '\n'.join(out)

if __name__ == '__main__':
    for path in sys.argv[1:]:
        with open(path) as f:
            src = f.read()
        with open(path, 'w') as f:
            f.write(strip_wraps(src))
